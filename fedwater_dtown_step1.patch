diff --git a/src/fedwater/utils.py b/src/fedwater/utils.py
new file mode 100644
index 0000000..d3be846
--- /dev/null
+++ b/src/fedwater/utils.py
@@ -0,0 +1,32 @@
+"""Small shared utilities.
+
+``stable_hash`` exists because Python salts ``str``/``tuple`` hashing per
+process (PEP 456) unless ``PYTHONHASHSEED`` is fixed in the environment.
+Seeding a ``numpy`` RNG with the builtin ``hash()`` of a sensor name or a
+district pair therefore makes that RNG's stream depend on process start-up
+noise, not on ``seed`` — the same call with the same ``seed`` silently
+produces a different stream on every run.
+
+Measured impact before this was fixed: three runs of
+``sensing.add_measurement_noise(seed=42)`` on identical input gave observed
+value sums of 856968.38 / 856991.23 / 856983.29. That breaks the "same seed,
+same dataset, bit for bit" invariant, and does so silently — there is no
+error, only a different number each time.
+"""
+from __future__ import annotations
+
+import zlib
+
+
+def stable_hash(obj) -> int:
+    """A reproducible, non-negative hash in ``[0, 2**31)``.
+
+    Uses ``repr(obj)`` rather than ``obj`` itself: for the ``str`` and
+    ``tuple``-of-``str`` keys this is used with (sensor names, district-pair
+    tuples), ``repr`` is a stable, process-independent string, so the crc32
+    of its UTF-8 encoding is stable across processes and across machines —
+    exactly the property ``hash()`` does not have. Callers that previously
+    wrote ``hash(x) % 2**31`` should call ``stable_hash(x)`` directly; the
+    modulus is already applied here.
+    """
+    return zlib.crc32(repr(obj).encode()) % 2**31
